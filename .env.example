# Supabase Credentials (sample mode defaults to true if blank)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SETTINGS_ENCRYPTION_KEY=

# Agent model gateway
AGENT_DEFAULT_MODEL_PROVIDER=google
AGENT_DEFAULT_MODEL=gemini-2.5-flash

# Google Gemini / Google Generative AI
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=

# Optional NVIDIA NIM / OpenAI-compatible provider
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_NIM_MODEL=

# Optional profile-level overrides
AGENT_DECISION_MODEL=
AGENT_EXTRACTION_MODEL=
AGENT_CREATIVE_PROVIDER=
AGENT_CREATIVE_MODEL=
AGENT_CRITIQUE_PROVIDER=
AGENT_CRITIQUE_MODEL=
AGENT_FINAL_PROVIDER=
AGENT_FINAL_MODEL=

# Test/runtime selection
AGENT_MODEL_PROFILE=test_fake

HUGGINGFACE_API_KEY=

# Toggle Sample Mode (set "true" to run with local seeded mock database)
NEXT_PUBLIC_SAMPLE_MODE=false

# Use the tool-aware agent runtime.
AGENT_HARNESS_RUNTIME_ENABLED=true
AGENT_HARNESS_RUNTIME_VERSION=v4

# Agent Runtime v4 orchestration experiment. Defaults to custom.
AGENT_ORCHESTRATOR=custom
